# fitlyfe-db holds the Postgres credentials. Create it OUTSIDE git, e.g.:
#
#   kubectl -n fitlyfe create secret generic fitlyfe-db \
#     --from-literal=host=<db host> \
#     --from-literal=port=5432 \
#     --from-literal=username=<db user> \
#     --from-literal=password=<db password> \
#     --from-literal=database=fitlyfe
#
# Never commit real credentials. (This file intentionally creates nothing.)
